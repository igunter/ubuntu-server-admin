{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListRehearsalBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::dbs-check-crm-rehearsal-backups"
    },
    {
      "Sid": "ReadObjectsInRehearsalBucket",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::dbs-check-crm-rehearsal-backups/*"
    },
    {
      "Sid": "NeverTheLiveBucket",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::dbs-check-crm-backups",
        "arn:aws:s3:::dbs-check-crm-backups/*"
      ]
    }
  ]
}
